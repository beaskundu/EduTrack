package EduTrack;
import java.io.*;
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        StudentManager sm = new StudentManager();
        sm.loadStudents();

        while (true) {
            System.out.println("\n1.Add 2.View 3.Search 4.Topper 5.Avg 6.Analyze 7.Risk 8.Exit");
            int ch = sc.nextInt();

            switch (ch) {
            case 1:
                System.out.print("ID: ");
                int id = sc.nextInt();

                sc.nextLine(); 

                System.out.print("Name: ");
                String name = sc.nextLine();

                System.out.print("Marks: ");
                double marks = sc.nextDouble();

                sm.addStudent(new Student(id, name, marks));
                break;
                case 2:
                    sm.displayAll();
                    break;

                case 3:
                    System.out.print("Enter ID: ");
                    sm.searchById(sc.nextInt());
                    break;

                case 4:
                    sm.findTopper();
                    break;

                case 5:
                    sm.averageMarks();
                    break;

                case 6:
                    sm.analyzePerformance();
                    break;

                case 7:
                    sm.predictRisk();
                    break;

                default:
                    System.out.println("Exiting...");
                    return;
            }
        }
    }
}

class StudentManager {
    List<Student> students = new ArrayList<>();
    String file = "students.txt";

    void addStudent(Student s) {
        students.add(s);
        saveToFile(s);
    }

    void saveToFile(Student s) {
        try (FileWriter fw = new FileWriter(file, true)) {
            fw.write(s.toString() + "\n");
        } catch (IOException e) {
            System.out.println("Error saving file");
        }
    }

    void loadStudents() {
        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] data = line.split(",");
                students.add(new Student(
                        Integer.parseInt(data[0]),
                        data[1],
                        Double.parseDouble(data[2])
                ));
            }
        } catch (IOException e) {
            System.out.println("No previous data.");
        }
    }

    void displayAll() {
        for (Student s : students) {
            System.out.println(s.id + " - " + s.name + " - " + s.marks);
        }
    }

    void searchById(int id) {
        for (Student s : students) {
            if (s.id == id) {
                System.out.println("Found: " + s.name + " - " + s.marks);
                return;
            }
        }
        System.out.println("Not found");
    }

    // Topper
    void findTopper() {
        if (students.isEmpty()) return;

        Student top = students.get(0);
        for (Student s : students) {
            if (s.marks > top.marks) {
                top = s;
            }
        }
        System.out.println("Topper: " + top.name + " (" + top.marks + ")");
    }

    void averageMarks() {
        if (students.isEmpty()) return;

        double sum = 0;
        for (Student s : students) sum += s.marks;

        System.out.println("Average: " + (sum / students.size()));
    }

    
    void analyzePerformance() {
        for (Student s : students) {
            if (s.marks >= 80) {
                System.out.println(s.name + " → High Performer ");
            } else if (s.marks >= 50) {
                System.out.println(s.name + " → Average ");
            } else {
                System.out.println(s.name + " → Needs Attention ");
            }
        }
    }

    void predictRisk() {
        for (Student s : students) {
            if (s.marks < 40) {
                System.out.println("⚠️ " + s.name + " is at risk of failing!");
            }
        }
    }
}
public class Student {
	int id;
    String name;
    double marks;

    Student(int id, String name, double marks) {
        this.id = id;
        this.name = name;
        this.marks = marks;
    }

    public String toString() {
        return id + "," + name + "," + marks;
    }

}
